{
	"name": "cast-cue",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"db:migrate:local": "wrangler d1 migrations apply cast-cue-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply cast-cue-db --remote",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@heroui/react": "^3.2.4",
		"@heroui/styles": "^3.2.4",
		"@opennextjs/cloudflare": "^1.20.2",
		"better-auth": "^1.6.27",
		"next": "15.5.23",
		"next-themes": "^0.4.6",
		"react": "^19.1.7",
		"react-dom": "^19.1.7"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"sharp",
			"unrs-resolver"
		]
	},
	"devDependencies": {
		"@better-auth/kysely-adapter": "1.6.27",
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^20",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"auth": "^1.6.27",
		"better-sqlite3": "^13.0.3",
		"eslint": "^9",
		"eslint-config-next": "15.5.23",
		"kysely": "^0.29.5",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"wrangler": "^4.123.0"
	}
}
