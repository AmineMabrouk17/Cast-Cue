# Copy to .env.local and fill in real values. Never commit .env.local.
# See .dev.vars.example for the wrangler (Worker) equivalents.

# Better Auth
# BETTER_AUTH_URL defaults to http://localhost:3000 in development.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Media metadata providers
TMDB_API_KEY=
OMDB_API_KEY=
# Trakt — https://trakt.tv/oauth/applications (client id, no OAuth needed for search)
TRAKT_CLIENT_ID=
